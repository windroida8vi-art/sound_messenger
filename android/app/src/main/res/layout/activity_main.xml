<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">


    <View android:layout_width="320dp" android:layout_height="320dp"
        android:layout_gravity="top|start" android:layout_marginTop="-80dp" android:layout_marginStart="-100dp"
        android:background="@drawable/bg_blob_purple" />
    <View android:layout_width="360dp" android:layout_height="360dp"
        android:layout_gravity="bottom|end" android:layout_marginBottom="-120dp" android:layout_marginEnd="-120dp"
        android:background="@drawable/bg_blob_cyan" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="آهنگ مخفی" android:textColor="#FFFFFF"
            android:textSize="36sp" android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:layout_marginBottom="36dp"
            android:text="پیام را داخل آهنگ پنهان کن" android:textColor="#B3FFFFFF"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/btnSender"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp"
            android:background="@drawable/bg_glass_press"
            android:clickable="true" android:focusable="true"
            android:contentDescription="فرستنده، ارسال متن داخل آهنگ"
            android:layout_marginBottom="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🎵  فرستنده" android:textColor="#FFFFFF"
                android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="ارسال متن داخل آهنگ" android:textColor="#B3FFFFFF" android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnReceiver"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp"
            android:background="@drawable/bg_glass_press"
            android:clickable="true" android:focusable="true"
            android:contentDescription="گیرنده، شنیدن و دریافت متن زنده">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🎧  گیرنده" android:textColor="#FFFFFF"
                android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="شنیدن و نمایش زنده متن" android:textColor="#B3FFFFFF" android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
